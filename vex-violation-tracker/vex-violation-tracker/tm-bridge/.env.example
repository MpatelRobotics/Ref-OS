# Ref-OS ↔ TM bridge — copy to ".env" and fill in. NEVER commit the real .env.

# From your APPROVED TM API credentials request:
TM_CLIENT_ID=
TM_CLIENT_SECRET=

# From the Event Partner, who enables the local API in Tournament Manager
# (Tools → Settings/Options → Web Publishing) and generates this key:
TM_API_KEY=

# The TM machine on the venue LAN — host or host:port (no scheme).
TM_HOST=localhost:8080
# TM_SCHEME=http    # usually http on the local network

# Your Ref-OS Supabase project + a key allowed to insert/update the matches table.
SUPABASE_URL=
SUPABASE_KEY=

# The Ref-OS event id (same UUID the app uses).
EVENT_ID=11111111-1111-4111-8111-111111111111

# Optional:
# TM_DIVISION_ID=1   # division to sync (most single-division events use 1)
# POLL_SECONDS=60     # how often to poll (min 30; guide recommends ~60)
# SYNC_WINNERS=1      # also sync match winners from TM (off by default — app controls the bracket)
# DRY_RUN=1           # log what it WOULD sync without writing to Supabase
