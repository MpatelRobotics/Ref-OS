# Copy this file to ".env" and fill in the values.
# Supabase dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# The single shared password refs type to open the site. Change this to
# whatever you want to hand your crew. Set the same value in your host later.
VITE_SITE_PASSWORD=Highlander2026

# Admin password required for Event setup and CSV export.
# Set this separately from the crew site password.
VITE_ADMIN_PASSWORD=ChangeThisAdminPassword

# Optional: a separate password for a Judge Advisor. Anyone entering this at the
# login screen gets a restricted view — only the Judging tab and nomination export.
VITE_JUDGE_PASSWORD=ChangeThisJudgePassword

# Optional: a separate password for an Emcee / announcer. Anyone entering this gets
# a read-only announcer view: Teams (with W-L-T records), Matches (scores + winners),
# Robots, and Judging (can add and view award nominations). Violations, the watchlist,
# the field log, and finalist/export tools are all hidden from this role.
VITE_EMCEE_PASSWORD=ChangeThisEmceePassword
