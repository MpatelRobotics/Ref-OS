# Copy this file to ".env" and fill in the values.
# Supabase dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
VITE_VAPID_PUBLIC_KEY=your-public-vapid-key

# Server credential setup values.
# These are read by scripts/generate-access-security-sql.mjs and are NOT referenced
# by the browser application. After generating the SQL, store the hashes in Supabase.
REFOS_SITE_PASSWORD=Highlander2026
REFOS_ADMIN_PASSWORD=ChangeThisAdminPassword
REFOS_JUDGE_PASSWORD=ChangeThisJudgePassword
REFOS_EMCEE_PASSWORD=ChangeThisEmceePassword

# Optional display version.
VITE_APP_VERSION=1.2.0
