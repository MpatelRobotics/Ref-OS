# systemd unit for Raspberry Pi / Linux. See VENUE-SERVER.md.
# Copy to /etc/systemd/system/refos-venue.service and edit User and paths.
[Unit]
Description=Ref OS Venue Server
After=network-online.target
Wants=network-online.target

[Service]
User=pi
WorkingDirectory=/home/pi/Ref-os/venue-server
Environment=PORT=8080
Environment=REFOS_VENUE_DATA=/home/pi/Ref-os/venue-server/data
ExecStart=/usr/bin/node --no-warnings server.mjs
Restart=on-failure

[Install]
WantedBy=multi-user.target
